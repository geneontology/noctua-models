:R-HSA-373076  a            owl:NamedIndividual , obo:GO_0007186 ;
        rdfs:comment        "Rhodopsin-like receptors (class A/1) are the largest group of GPCRs and are the best studied group from a functional and structural point of view. They show great diversity at the sequence level and thus, can be subdivided into 19 subfamilies (Subfamily A1-19) based on a phylogenetic analysis (Joost P and Methner A, 2002). They represent members which include hormone, light and neurotransmitter receptors and encompass a wide range of functions including many autocrine, paracrine and endocrine processes." ;
        rdfs:label          "Class A/1 (Rhodopsin-like receptors)" ;
        dc:contributor      "Edited: D'Eustachio, P, 2008-09-01 11:58:31" , "Reviewed: Bockaert, J, 2008-09-01 12:04:13" , "GOC:reactome_curators" , "Authored: Jassal, B, 2008-07-03 10:57:39" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-373076" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-500792/R-HSA-500792> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

