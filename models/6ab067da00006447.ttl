gomodel:6ab067da00006447
        a                      owl:Ontology ;
        rdfs:comment           "Curated with GO AI HUB. ATG2A transfers phosphatidylinositol (PI) from the ER into ATG9A compartments, where the PI3KC3-C1 complex converts it to PI3P; PI3P-activated WIPI4 and membrane-bound LC3B bind ATG2A and enhance its lipid transfer, a positive feedback loop in autophagosome assembly (PMID:42816491)." ;
        lego:conforms_to_gpad  false ;
        lego:modelstate        "production" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-10-09" ;
        dc:title               "ATG2A transfers phosphatidylinositol to ATG9A vesicles for PI3P synthesis in autophagosome assembly (Human)" ;
        pav:providedBy         "https://www.uniprot.org" , "http://geneontology.org" ;
        owl:versionIRI         gomodel:6ab067da00006447 ;
        biolink:in_taxon       obo:NCBITaxon_9606 .

