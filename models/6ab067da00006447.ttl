<http://model.geneontology.org/6ab067da00006447> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00006447> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-08"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "ATG2A transfers phosphatidylinositol to ATG9A vesicles for PI3P synthesis in autophagosome assembly (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                   "https://www.uniprot.org" ;
                                                  rdfs:comment "Curated with GO AI HUB. ATG2A transfers phosphatidylinositol (PI) from the ER into ATG9A compartments, where the PI3KC3-C1 complex converts it to PI3P; PI3P-activated WIPI4 and membrane-bound LC3B bind ATG2A and enhance its lipid transfer, a positive feedback loop in autophagosome assembly (PMID:42816491)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

