:R-HSA-8939245  a           owl:NamedIndividual , obo:GO_0050855 ;
        rdfs:comment        "The RUNX1:CBFB complex, in association with transcription co-factors ELF1 (MEF), ELF2 (NERF2) or PAX5 (BSAP) stimulates transcription of the BLK gene, encoding a B-cell specific tyrosine kinase involved in B cell receptor (BCR) signaling, B cell development and differentiation (Libermann et al. 1999, Cho et al. 2004)." ;
        rdfs:label          "RUNX1 regulates transcription of genes involved in BCR signaling" ;
        dc:contributor      "Reviewed: Chuang, Linda Shyue Huey, 2016-12-20" , "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2016-09-14" , "Reviewed: Ito, Yoshiaki, 2016-12-20" , "Edited: Orlic-Milacic, Marija, 2017-05-09" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8939245" ;
