obo:RO_0002411  a  owl:ObjectProperty .

:R-HSA-2142816  a           obo:GO_0097267 , owl:NamedIndividual ;
        rdfs:comment        "Similar to the lipoxygenases, cytochrome P450 (CYP) enzymes catalyse the hydroxylation and epoxygenation of arachidonic acid. However, whereas lipoxygenases use an active non-heme iron to abstract hydrogen directly from arachidonic acid, CYPs contain a heme-iron active site that oxidizes its substrate by a different mechanism. They hydroxylate arachidonic acid between C-5 and C-15 to produce lipoxygenase-like hydroxyeicosatetraenoic acids (HETEs) and add a hydroxyl moiety to the sp3-hybridized omega-carbons to form a unique class of HETEs. The transfer of oxygen to the unstable arachidonic acid intermediate terminates the reaction by forming HETE or epoxy-eicosatrienoic acid (EETs), respectively (Capdevila et al. 2000, Buczynski et al. 2009, Vance & Vance 2008)." ;
        rdfs:label          "Synthesis of (16-20)-hydroxyeicosatetraenoic acids (HETE)" ;
        dc:contributor      "Reviewed: Rush, MG, 2012-11-10" , "GOC:reactome_curators" , "Edited: Williams, MG, 2012-02-24" , "Authored: Williams, MG, 2012-02-24" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-2142816" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-2142753/R-HSA-2142753> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

