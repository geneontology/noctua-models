gomodel:693b3c0900002145
        a                 owl:Ontology ;
        rdfs:comment      "'Light stimulus' activates opsin (i.e. apo-opsin linked to chromophore 11-cis retinal). Do not know how to express this in the model. Using all-trans retinal (the product of 11-cis retinal activation) as small molecule that activates opsin seems misleading to me." ;
        lego:modelstate   "delete" ;
        dc:contributor    "https://orcid.org/0000-0002-5283-6593" ;
        dc:date           "2026-06-19" ;
        dc:title          "Test_Vision_part1_phototransduction in cones" ;
        pav:providedBy    "https://www.uniprot.org" ;
        biolink:in_taxon  obo:NCBITaxon_9606 .

