<http://model.geneontology.org/6ab067da00005862> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00005862> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-06"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "autophagosome assembly via ATG2A phosphatidylserine transfer (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Curated with GO AI HUB. ATG2A transfers phosphatidylserine from the ER (supplied by the TMEM41B scramblase) to the phagophore, where ATG9A scrambles it; the TOM70-TOM40 (TOM complex) recruits ATG2A to the MAM, in autophagosome assembly."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

