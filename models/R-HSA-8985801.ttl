:R-HSA-8985801  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Besides being involved in axon repulsion during neuronal system development, SLIT-ROBO signaling is also involved in dendrite branching. Based on studies in mice, SLIT1 triggers cortical dendrite branching by activating receptors ROBO1 and/or ROBO2. ROBO effector NCK2 is needed for SLIT1-mediated dendrite branching (Round and Sun 2011)." ;
        rdfs:label          "Regulation of cortical dendrite branching" ;
        dc:contributor      "GOC:reactome_curators" , "Edited: Orlic-Milacic, Marija, 2017-06-26" , "Reviewed: Jaworski, Alexander, 2017-07-31" , "Authored: Orlic-Milacic, Marija, 2017-06-26" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8985801" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-376176/R-HSA-376176> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .
