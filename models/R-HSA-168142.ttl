obo:BFO_0000050  a  owl:ObjectProperty .

:R-HSA-168142  a            obo:GO_0034166 , owl:NamedIndividual ;
        rdfs:comment        "Little is known about TLR10 ligands. It has been established that the receptor homodimerizes upon binding and signals in an MyD88-dependent manner (Hasan U et al 2005; Nyman T et al 2008). It may also heterodimerize with TLRs 1 and 2. It is expressed in a restricted fashion as a highly N-glycosylated protein detectable in B cells and dendritic cells." ;
        rdfs:label          "Toll Like Receptor 10 (TLR10) Cascade" ;
        dc:contributor      "Authored: Luo, F, 2005-11-10 11:23:18" , "Reviewed: Gale M, Jr, 2006-10-31 16:45:01" , "Edited: Shamovsky, V, 2011-08-12" , "Reviewed: Gillespie, ME, 2011-02-10" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-168142" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-168898/R-HSA-168898> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

