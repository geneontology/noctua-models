:R-HSA-73779  a             owl:NamedIndividual , obo:GO_0006367 ;
        rdfs:comment        "Formation of the pre-initiation complex proceeds in five steps, recognition and binding of core promoter elements by TFIID, binding of TFIIA and TFIIB to the pol II promoter:TFIID complex, recruitment of RNA Polymerase II Holoenzyme by TFIIF to the pol II promoter:TFIID:TFIIA:TFIIB complex, binding of TFIIE to the growing preinitiation complex, and formation of the closed pre-initiation complex (Orphanides et al. 1997)." ;
        rdfs:label          "RNA Polymerase II Transcription Pre-Initiation And Promoter Opening" ;
        dc:contributor      "Authored: Reinberg, D, 2003-09-11 07:42:30" , "Edited: Joshi-Tope, G, 0000-00-00 00:00:00" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-73779" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-73857/R-HSA-73857> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

