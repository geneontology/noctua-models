###  http://model.geneontology.org/6ab067da00006813/6ab067da00007482
<http://model.geneontology.org/6ab067da00006813/6ab067da00007482> rdf:type owl:NamedIndividual ,
                                                                           <http://purl.obolibrary.org/obo/PR_000000001> ;
