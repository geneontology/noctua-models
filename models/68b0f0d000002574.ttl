gomodel:68b0f0d000002574
        a                 owl:Ontology ;
        rdfs:comment      "General: Reviewed via claude4go.\nB4GALT6 replaced by B4GALT5, the major LacCer synthase (PMID:24498430) and LCS of PMID:23913272. \nABC MF/CC are inferences from KD data (PMID:34597626); no transport assay exists. \nRizzo 2021  (PMID:33749896) places LCS/Gb3S in the trans cisterna; D'Angelo 2013 shows Gb3S at the TGN. B4GALT5 spin-off: gomodel:6a4c244800001279" ;
        lego:modelstate   "production" ;
        dc:contributor    "https://orcid.org/0009-0002-7487-1936" ;
        dc:date           "2026-11-03" ;
        dc:title          "Gb3 biosynthesis via PLEKHA8, ABCA12/ABCB4, B4GALT5, A4GALT at TGN (Human)" ;
        pav:providedBy    "https://holthuis-lab-uos.de" ;
        <http://www.w3.org/ns/prov#wasDerivedFrom>
