        pav:providedBy  "https://reactome.org" .

:R-HSA-69091  a             obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "After the primers are synthesized, Replication Factor C binds to the 3'-end of the initiator DNA to trigger polymerase switching. The non-processive nature of pol alpha catalytic activity and the tight binding of Replication Factor C to the primer-template junction presumably lead to the turnover of the pol alpha:primase complex. After the Pol alpha-primase primase complex is displaced from the primer, the proliferating cell nuclear antigen (PCNA) binds to form a \"sliding clamp\" structure. Replication Factor C then dissociates, and DNA polymerase delta binds and catalyzes the processive synthesis of DNA." ;
        rdfs:label          "Polymerase switching" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-69091" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-69186/R-HSA-69186> , <http://model.geneontology.org/R-HSA-69109/R-HSA-69109> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

