gomodel:ev_w_id_R-HSA-9605600_RO_0002333_R-HSA-9605640_R-HSA-9605600_controller_Reactome_R-HSA-9037629
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
