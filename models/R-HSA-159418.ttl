gomodel:ev_w_id_R-HSA-5340251_RO_0002233_R-HSA-442496_R-HSA-5340251_Reactome_R-HSA-5340251
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
