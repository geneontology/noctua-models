skos:exactMatch  a  owl:AnnotationProperty .

:R-HSA-375280  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "The class A (rhodopsin-like) GPCRs that bind to classical biogenic amine ligands are annotated here. The amines involved (acetylcholine, adrenaline, noradrenaline, dopamine, serotonin and histamine) can all act as neurotransmitters in humans. The so-called 'trace amines', used when referring to p-tyramine, beta-phenylethylamine, tryptamine and octopamine, can also bind to recently-discovered GPCRs." ;
        rdfs:label          "Amine ligand-binding receptors" ;
        dc:contributor      "Authored: Jassal, B, 2008-08-21 14:55:38" , "Reviewed: D'Eustachio, P, 2009-03-02 09:24:35" , "GOC:reactome_curators" , "Edited: Jassal, B, 2008-08-21 14:55:38" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-375280" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-373076/R-HSA-373076> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

