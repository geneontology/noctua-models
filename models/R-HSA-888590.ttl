gomodel:ev_w_id_R-HSA-917744_RO_0002233_R-HSA-2029017_R-HSA-917744_Reactome_R-HSA-888590
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
