obo:CHEBI_87728  a  owl:Class .

:62f58d8800006264  a    obo:CHEBI_87728 , owl:NamedIndividual ;
        rdfs:comment    "General: Waiting for chbi of intermediate small molecule and enzyme: On CHEBI:166734. It is 2-star, has no definition, and its only parent is \"bile acid\". It has no conjugate base, so it is the acid while the other 3 compounds in the model are anions. And it is not in chebi_import.owl, which is why Noctua rejects it. Ask for: 3-star, a definition, classification as 3β-hydroxy-5α-cholan-24-oic acid under 5α-cholanic acid (CHEBI:36239), and the isoallolithocholate anion. The anion is the one the model should use." ;
        layout:x        "2130.5" ;
        layout:y        "383.5" ;
        obo:RO_0012005  :6ac817cf00005413 ;
        obo:RO_0012006  :62f58d8800006295 ;
        dc:contributor  "https://orcid.org/0000-0001-8769-177X" ;
        dc:date         "2026-10-21" ;
        pav:providedBy  "https://www.uniprot.org" .

