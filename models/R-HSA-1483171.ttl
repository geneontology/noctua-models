:R-HSA-1483171  a           owl:NamedIndividual , obo:GO_2001312 ;
        rdfs:comment        "Lysobisphosphatidic acid, also known as bis(monoacylglycerol) hydrogen phosphate (BMP), is enriched in late endosomes and not found in the endoplasmic reticulum (ER) or mitochondria where phosphatidylglycerol (PG) is synthesized. Late endosomes form membrane contact sites with the ER, providing a means for PG to enter the late endosome and be converted to BMP via hydrolysis by a phospholipase A2, followed by acylation, and a reorientation of the phosphoryl ester (Poorthuis & Hostetler 1978, Heravi & Waite 1999, Hullin-Matsuda et al. 2007, Gallala & Sandhoff 2010)." ;
        rdfs:label          "Synthesis of BMP" ;
        dc:contributor      "Edited: Williams, MG, 2011-08-12" , "Authored: Williams, MG, 2011-09-14" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-1483171" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1483206/R-HSA-1483206> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

