pav:providedBy  a  owl:AnnotationProperty .

:R-HSA-9758881  a           obo:GO_0015889 , owl:NamedIndividual ;
        rdfs:comment        "The steps of transport of dietary cobalamins through the digestive tract to the distal ileum, leading to its endocytosis are annotated here. The proteins involved in these processes accommodate cobalamins including cyanocobalamin, methylcobalamin, and adenosylcobalamin. (Banerjee et al. 2021; Nielsen et al. 2012; Quadros 2010). This broad specificity is indicated by annotating R-cob(III)alamin (RCbl - CHEBI:140785) as the cargo in all of these processes." ;
        rdfs:label          "Uptake of dietary cobalamins into enterocytes" ;
        dc:contributor      "Authored: Jassal, B, 2007-04-24 08:38:46" , "Edited: D'Eustachio, Peter, 2021-11-26" , "Reviewed: Hill, David P, 2022-02-14" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9758881" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-196741/R-HSA-196741> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

