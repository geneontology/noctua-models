:R-HSA-111996  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Calcium, as the ion Ca2+, is essential in many biological processes. The majority of Ca2+ in many organisms is bound to phosphates which form skeletal structures and also buffer Ca2+ levels in extracellular fluids (typically 1 millimolar). Intracellular free Ca2+, by contrast, is 10,000 times lower than the outside of the cell (typically 10 micromolar). This concentration gradient is used to import Ca2+ into cells where it acts as a second messenger." ;
        rdfs:label          "Ca-dependent events" ;
        dc:contributor      "Reviewed: Castagnoli, L, 2008-11-06 12:55:54" , "GOC:reactome_curators" , "Authored: Le Novere, N, Jassal, B, 2004-03-31 12:22:05" , "Edited: Jassal, Bijay, 2008-11-06" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-111996" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-112043/R-HSA-112043> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

