:R-HSA-389948  a            owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "The Programmed cell death protein 1 (PD-1) is one of the negative regulators of TCR signaling. PD-1 may exert its effects on cell differentiation and survival directly by inhibiting early activation events that are positively regulated by CD28 or indirectly through IL-2. PD-1 ligation inhibits the induction of the cell survival factor Bcl-xL and the expression of transcription factors associated with effector cell function, including GATA-3, Tbet, and Eomes. PD-1 exerts its inhibitory effects by bringing phosphatases SHP-1 and SHP-2 into the immune synapse, leading to dephosphorylation of CD3-zeta chain, PI3K and AKT." ;
        rdfs:label          "PD-1 signaling" ;
        dc:contributor      "GOC:reactome_curators" , "Edited: Garapati, P V, 2008-12-16 11:12:19" , "Authored: Garapati, P V, 2008-12-16 11:12:19" , "Reviewed: Bluestone, JA, Esensten, J, 2009-06-01 18:47:33" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-389948" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-388841/R-HSA-388841> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

