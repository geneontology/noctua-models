obo:RO_0002411  a  owl:ObjectProperty .

:R-HSA-380270  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "The mitotic spindle becomes established once centrosomes have migrated to opposite poles and the nuclear envelope has broken down. During this stage, interphase centrosomes mature into mitotic centrosomes recruiting additional gamma TuRC complexes and acquiring mitosis-associated centrosomal proteins including NuMA, Plk1 and CDK11p58 (reviewed in Schatten 2008; Raynaud-Messina and Merdes 2007)." ;
        rdfs:label          "Recruitment of mitotic centrosome proteins and complexes" ;
        dc:contributor      "Reviewed: Merdes, A, 2008-11-17 13:55:29" , "Authored: Matthews, L, 2008-11-11 14:53:40" , "GOC:reactome_curators" , "Edited: Matthews, L, 2008-11-09 05:12:41" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-380270" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-380287/R-HSA-380287> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

