obo:GO_0060079  a  owl:Class .

obo:RO_0002333  a  owl:ObjectProperty .

gomodel:6ac817cf00001061
        a                 owl:Ontology ;
        rdfs:comment      "Comment to reviewer: Output of signaling via glutamate depends on light and dark condition. In the light: less glutamate release by the photoreceptor -> less glutamate in the synaptic cleft means less activation of kainate receptor complex on the OFF cells -> membrane hyperpolarization of OFF cells -> OFF cells are inhibited.\nIn the dark: continuos glutamate release by the photoreceptor -> more glutamate in the synaptic cleft means activation of kainate receptor complex on the OFF cells -> membrane depolarization of OFF cells -> OFF cells are activated." ;
        lego:modelstate   "development" ;
        dc:contributor    "https://orcid.org/0000-0002-5283-6593" ;
        dc:date           "2026-10-15" ;
        dc:title          "Visual perception: Glutamate acts on OFF cone bipolar cells via kainate glutamate receptor complex (Human)." ;
        pav:providedBy    "https://www.uniprot.org" ;
        owl:versionIRI    gomodel:6ac817cf00001061 ;
        biolink:in_taxon  obo:NCBITaxon_9606 .

