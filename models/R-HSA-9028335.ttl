:R-HSA-9028335  a           obo:GO_0051897 , owl:NamedIndividual ;
        rdfs:comment        "Neurotrophin receptor NTRK2 (TRKB), activated by BDNF or NTF4, activates PI3K, resulting in formation of the PIP3 secondary messenger. PIP3 activates AKT signaling, and AKT signaling activates mTOR signaling (Yuen and Mobley 1999, Cao et al. 2013)." , "Automated change 2023-07-27: GO:0014068 replaced by GO:0051897" ;
        rdfs:label          "Activated NTRK2 signals through PI3K" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: CastrÃ©n, Eero, 2018-02-13" , "Reviewed: Antila, Hanna, 2018-02-13" , "Authored: Orlic-Milacic, Marija, 2018-01-05" , "Edited: Orlic-Milacic, Marija, 2018-02-20" ;
        dc:date             "2023-07-27" ;
