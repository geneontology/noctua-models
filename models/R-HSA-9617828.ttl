gomodel:R-HSA-9624975_R-HSA-9624976
        a                   owl:NamedIndividual , <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-9624975> ;
        rdfs:comment        "located_in nucleoplasm" ;
        rdfs:label          "FOXO1,FOXO3:CAV1 gene" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-9624975" ;
