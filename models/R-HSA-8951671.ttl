:R-HSA-8951671  a           owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "Association of RUNX3 with the TEADs:YAP1 complex inhibits loading of the TEADs:YAP1 to the CTGF promoter, thus negatively regulating transcription of the CTGF gene which encodes the Connective tissue growth factor (Yagi et al. 1999, Zhao et al. 2008, Qiao et al. 2016)." ;
        rdfs:label          "RUNX3 regulates YAP1-mediated transcription" ;
        dc:contributor      "Edited: Orlic-Milacic, Marija, 2017-01-31" , "Reviewed: Chuang, Linda Shyue Huey, 2017-01-31" , "Reviewed: Ito, Yoshiaki, 2017-01-31" , "Authored: Orlic-Milacic, Marija, 2016-12-12" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
