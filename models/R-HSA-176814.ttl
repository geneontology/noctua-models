obo:GO_0031145  a  owl:Class .

:R-HSA-176814  a            owl:NamedIndividual , obo:GO_0031145 ;
        rdfs:comment        "APC/C:Cdc20 is first activated at the prometaphase/metaphase transition through phosphorylation of core subunits of the APC/C by mitotic kinases as well as recruitment of the APC/C activator protein Cdc20. APC/C:Cdc20 promotes the multiubiquitination and ordered degradation of Cyclin A and Nek2 degradation in prometaphase followed by Cyclin B and securin in metaphase (Reviewed in Castro et al., 2005)." ;
        rdfs:label          "Activation of APC/C and APC/C:Cdc20 mediated degradation of mitotic proteins" ;
        dc:contributor      "Authored: Lorca, T, Castro, A, 2006-01-26 00:00:00" , "Reviewed: Peters, JM, 2006-03-27 22:55:09" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
