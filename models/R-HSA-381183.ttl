:R-HSA-381183  a            obo:GO_0036500 , owl:NamedIndividual ;
        rdfs:comment        "The N-terminal fragment of ATF6-alpha contains a bZIP domain and binds the sequence CCACG in ER Stress Response Elements (ERSEs). ATF6-alpha binds ERSEs together with the heterotrimeric transcription factor NF-Y, which binds the sequence CCAAT in the ERSEs, and together the two factors activate transcription of ER stress-responsive genes. Evidence from overexpression and knockdowns indicates that ATF6-alpha is a potent activator but its homolog ATF6-beta is not and ATF6-beta may actually reduce expression of ER stress proteins." ;
        rdfs:label          "ATF6 (ATF6-alpha) activates chaperone genes" ;
        dc:contributor      "GOC:reactome_curators" , "Edited: May, B, 2009-06-02 00:51:49" , "Reviewed: D'Eustachio, P, Matthews, L, Gillespie, ME, 2008-12-02 16:25:31" , "Reviewed: Urano, F, 2010-04-30" , "Authored: May, B, 2009-06-02 00:51:49" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-381183" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-381033/R-HSA-381033> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

