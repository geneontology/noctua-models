gomodel:ev_w_id_R-HSA-158333_RO_0002234_R-HSA-140897_R-HSA-158333_Reactome_R-HSA-140837
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
