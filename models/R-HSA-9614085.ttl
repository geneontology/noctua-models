:R-HSA-9614085  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "The family of FOXO transcription factors includes FOXO1, FOXO3, FOXO4 and FOXO6. FOXO transcription factors integrate pathways that regulate cell survival, growth, differentiation and metabolism in response to environmental changes, such as growth factor deprivation, starvation and oxidative stress (reviewed by Accili and Arden 2004, Calnan and Brunet 2008, Eijkelenboom and Burgering 2013)." ;
        rdfs:label          "FOXO-mediated transcription" ;
        dc:contributor      "Reviewed: Donlon, Timothy, 2018-10-17" , "Edited: Orlic-Milacic, Marija, 2018-10-31" , "Reviewed: Bertaggia, Enrico, 2018-10-26" , "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2018-10-11" ;
