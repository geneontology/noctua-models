        a                   owl:NamedIndividual , <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-2168851> ;
        rdfs:comment        "located_in extracellular region" ;
        rdfs:label          "HPX:Hemes" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-2168851" ;
