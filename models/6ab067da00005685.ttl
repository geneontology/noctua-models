        lego:modelstate        "development" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-10-09" ;
        dc:title               "Autophagosome assembly via ATG2A lipid transfer (Human)" ;
        pav:providedBy         "http://geneontology.org" , "https://www.uniprot.org" ;
