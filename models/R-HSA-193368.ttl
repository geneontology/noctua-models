gomodel:ev_w_id_R-HSA-192341_RO_0002333_UniProt_P22307-1_R-HSA-192341_controller_Reactome_R-HSA-192341
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
