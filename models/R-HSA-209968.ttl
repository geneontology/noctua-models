:R-HSA-209968  a            obo:GO_0006590 , owl:NamedIndividual ;
        rdfs:comment        "Thyroxine (3,5,3',5'-tetraiodothyronine, T4) promotes normal growth and development. It also regulates heat and energy production. T4 is released from the thyroid gland, the largest endocrine organ in the human body. The primary hormone released is T4 although T3 (3,5,3'-triiodothyronine) is also released in small quantities. Tyrosine residues in thyroglobulin (a glycoprotein scaffold containing many tyrosine residues) are iodinated to form mono- or diiodo-tyrosine which can then couple to form either T3 or T4." ;
        rdfs:label          "Thyroxine biosynthesis" ;
        dc:contributor      "GOC:reactome_curators" , "Edited: Jassal, B, 2008-05-28 09:06:10" , "Reviewed: D'Eustachio, P, 2008-05-28 08:30:54" , "Authored: Jassal, Bijay, 2008-10-01" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-209968" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-209776/R-HSA-209776> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

