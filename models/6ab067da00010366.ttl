<http://model.geneontology.org/6ab067da00010366> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00010366> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-22"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "PTEN in excitatory hippocampal synapse long-term depression (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Curated with GO AI HUB. Revised version of gomodel:62900b6400001630 (PTEN in NMDAR-dependent LTD) following review of 2026-10-22: ISS evidence moved to GO_REF:0000024 with RGD/MGI orthologs; PTEN-to-beta-catenin edge moved to a separate PTEN unit (PDZ-binding-motif role, PMID:33428810); SLC6A20 negatively regulates NMDAR via glycine clearance."^^xsd:string ,
                                                               "PTEN lipid phosphatase activity (GO:0016314) is drawn causally upstream of, negative effect, CTNNB1 at the curator's choice. Caveat: Bae 2021 (PMID:33428810) PtenDeltaC lacks the PDZ-binding motif but keeps normal AKT/mTOR phosphorylation (Fig EV1G) and still shows more nuclear beta-catenin (Fig 2D, 2F), so the effect may not need the phosphatase activity."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

