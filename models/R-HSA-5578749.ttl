<http://model.geneontology.org/ev_w_id_R-HSA-5578966_RO_0002339_end_loc_http://purl.obolibrary.org/obo/GO_0005654_R-HSA-5578966_Reactome_R-HSA-5578749>
        a               owl:NamedIndividual , obo:ECO_0000363 ;
