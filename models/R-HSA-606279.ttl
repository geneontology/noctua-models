lego:modelstate  a  owl:AnnotationProperty .

:R-HSA-606279  a            obo:GO_0034080 , owl:NamedIndividual ;
        rdfs:comment        "Eukaryotic centromeres are marked by a unique form of histone H3, designated CENPA in humans. In human cells newly synthesized CENPA is deposited in nucleosomes at the centromere during late telophase/early G1 phase of the cell cycle. Once deposited, nucleosomes containing CENPA remain stably associated with the centromere and are partitioned equally to daughter centromeres during S phase. A current model proposes that pre-existing CENPA at the centromere drives recruitment of new CENPA, however this has not been proved.<br>The deposition process requires at least 3 complexes: the Mis18 complex, HJURP complex, and the RSF complex. HJURP binds newly synthesized CENPA-H4 tetramers before deposition and brings them to the centromere for deposition in new CENPA-containing nucleosomes. The exact mechanism of deposition remains unknown." ;
        rdfs:label          "Deposition of new CENPA-containing nucleosomes at the centromere" ;
        dc:contributor      "Reviewed: Foltz, DR, 2010-06-14" , "Edited: May, B, 2010-04-15" , "Authored: May, B, 2010-04-15" , "GOC:reactome_curators" , "Reviewed: Almouzni-Pettinotti, G, Dunleavy, EM, 2010-05-30" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-606279" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-774815/R-HSA-774815> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

