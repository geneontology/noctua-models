dc:contributor  a  owl:AnnotationProperty .

:R-HSA-9988426  a           owl:NamedIndividual , obo:GO_0062014 ;
        rdfs:comment        "TP53 tetramer binds to sites in the promoter regions of the OTC, CPS1 and ARG1 genomic regions to repress transcription as assessed by ChIP and reporter gene assay (Li et al, 2019). Through transcriptional downregulation of these urea cycle enzymes, TP53 increases cellular ammonia levels, ultimately leading to increased proliferation through elevated polyamine synthesis (Li et al, 2019; reviewed in Holbert et al, 2022). Elevated ammonia promotes increased translation of ornithine decarboxylase (ODC), the first and rate limiting enzyme in polyamine biosynthesis (Li et al, 2019; Dufe et al, 2007; Kanerva et al, 2008; reviewed in Holbert et al, 2022)." ;
        rdfs:label          "Negative transcriptional regulation of urea cycle enzymes" ;
        dc:contributor      "Reviewed: Hill, David P, 2026-05-07" , "Authored: Rothfels, Karen, 2026-05-07" , "GOC:reactome_curators" ;
        dc:date             "2026-07-02" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9988426" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-70635/R-HSA-70635> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

