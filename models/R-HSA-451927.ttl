:R-HSA-451927  a            obo:GO_0019221 , owl:NamedIndividual ;
        rdfs:comment        "The interleukin-2 family (also called the common gamma chain cytokine family) consists of interleukin (IL)2, IL9, IL15 and IL21. Although sometimes considered to be within this family, the IL4 and IL7 receptors can form complexes with other receptor chains and are represented separately in Reactome. Receptors of this family associate with JAK1 and JAK3, primarily activating STAT5, although certain family members can also activate STAT1, STAT3 or STAT6." ;
        rdfs:label          "Interleukin-2 family signaling" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: Dooms, H, 2011-03-17" , "Reviewed: Villarino, A, 2011-02-11" , "Authored: Ray, KP, 2010-05-17" , "Edited: Jupe, S, 2010-08-06" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-451927" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-449147/R-HSA-449147> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .
