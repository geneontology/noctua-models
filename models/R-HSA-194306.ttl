:R-HSA-194306  a            owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "The plasma membrane-associated Neuropilin receptors NRP-1 and -2 bind some of the VEGF proteins and associate with VEGF receptor proteins. NRP-1 binds VEGF-A165, -B, and PLGF-2; NRP-2 also binds VEGF-A165 and PLGF-2, as well as VEGF-A145 and -C. The Neurolipin receptors appear to act as cofactors for the VEGF receptors, increasing their affinities for specific VEGF ligands, although the importance of this function in vivo remains unclear (Neufeld et al. 2002)." ;
        rdfs:label          "Neurophilin interactions with VEGF and VEGFR" ;
        dc:contributor      "Authored: Garapati, P V, 2013-08-30" , "Edited: Garapati, P V, 2013-08-30" , "Reviewed: Claesson-Welsh, L, 2008-02-28 00:15:17" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-194306" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-194138/R-HSA-194138> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

