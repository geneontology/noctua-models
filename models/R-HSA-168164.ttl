:R-HSA-168164  a            obo:GO_0034138 , owl:NamedIndividual ;
        rdfs:comment        "Toll-like receptor 3 (TLR3) as was shown for mammals is expressed on myeloid dendritic cells, respiratory epithelium, macrophages, and appears to play a central role in mediating the antiviral and inflammatory responses of the innate immunity in combating viral infections.<p>Mammalian TLR3 recognizes dsRNA, and that triggers the receptor to induce the activation of NF-kappaB and the production of type I interferons (IFNs). dsRNA-stimulated phosphorylation of two specific TLR3 tyrosine residues (Tyr759 and Tyr858) is essential for initiating TLR3 signaling pathways." ;
        rdfs:label          "Toll Like Receptor 3 (TLR3) Cascade" ;
        dc:contributor      "Authored: Luo, F, 2005-11-10 11:23:18" , "Reviewed: Gay, NJ, 2006-04-24 16:48:17" , "Edited: Shamovsky, V, 2011-08-12" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-168164" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-168898/R-HSA-168898> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

