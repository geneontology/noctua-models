dc:title  a     owl:AnnotationProperty .

:R-HSA-9974237  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "DNA double strand break response can be negatively regulated by ubiquitinylation-dependent proteasome-mediated degradation of proteins that orchestrate it. For example, 26S proteasome-mediated degradation of BRCA1 and its heterodimerization partner, BARD1, is triggered by polyubiquitination of these two proteins by the Cullin4-RBX1-DDB1 (CRL4) E3 ubiquitin ligase complexes that have DCAF8L1 or DCAF8L2 as their substrate recognition subunits, with CRL4A-DCAF8L1 targeting both BRCA1 and BARD1 (Liu et al. 2022), and CRL4-DCAF8L2 targeting BARD1 only (Deng et al. 2022)." ;
        rdfs:label          "Negative Regulation of DNA Double Strand Break Response" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2025-11-21" ;
        dc:date             "2026-07-02" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9974237" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-5693606/R-HSA-5693606> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

