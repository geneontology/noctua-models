:R-HSA-561048  a            owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "Organic anion transporters (OATs) mediate the renal absorption and excretion of a broad range of endogenous substrates and anionic drugs such as diuretics and NSAIDs. Five members belong to these polyspecific transporters (OAT1-4 and URAT1) and are predominantly expressed in the kidney (Koepsell H and Endou H, 2004; Rizwan AN and Burckhardt G, 2007; Ahn SY and Bhatnagar V, 2008)." ;
        rdfs:label          "Organic anion transport" ;
        dc:contributor      "Reviewed: He, L, 2010-05-10" , "Edited: Jassal, Bijay, 2010-03-25" , "GOC:reactome_curators" , "Authored: Jassal, Bijay, 2010-03-25" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-561048" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-549132/R-HSA-549132> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

