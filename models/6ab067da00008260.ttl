###  http://model.geneontology.org/6ab067da00008260/6ab067da00010503
<http://model.geneontology.org/6ab067da00008260/6ab067da00010503> rdf:type owl:NamedIndividual ,
                                                                           <http://purl.obolibrary.org/obo/ECO_0000250> ;
                                                                  <http://geneontology.org/lego/evidence-with> "MGI:1354739"^^xsd:string ;
                                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0003-1522-9900" ;
                                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-23"^^xsd:string ;
                                                                  <http://purl.org/dc/elements/1.1/source> "GO_REF:0000024"^^xsd:string ;
                                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                                  rdfs:comment "Cao 2009 PMID:19625520 Fig. 8: purified mouse RGS11/Gbeta5S stimulates Galpha-o GTPase ~10-fold in vitro. Cao 2012 PMID:22547806 Figs. 3-4: Rgs7/Rgs11 double KO mice lack the ERG b-wave; rod ON-bipolar cells lose flash responses and respond ~40-fold slower to bright steps; single KOs near normal (IGI with Rgs7)."^^xsd:string .


