gomodel:ev_w_id_R-HSA-936991_RO_0002411_R-HSA-168184_Reactome_R-HSA-9020702
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
