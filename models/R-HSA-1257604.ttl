gomodel:ev_w_id_R-HSA-388830_RO_0002234_R-HSA-388785_R-HSA-388830_Reactome_R-HSA-388841
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
