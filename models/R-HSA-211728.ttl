dc:title  a     owl:AnnotationProperty .

<http://purl.obolibrary.org/obo/go/extensions/reacto.owl#molecular_event>
        a       owl:Class .

:R-HSA-211728  a            owl:NamedIndividual , obo:GO_0043066 ;
        rdfs:comment        "PS-GAP (RGH10) interacts specifically with caspase-activated PAK-2p34 reducing the ability of PAK-2p34 to induce cell death. This interaction inhibits the kinase activity of PAK-2p34 and changes the localization of PAK-2p34 from the nucleus to the perinuclear region (Koeppel et al., 2004)." ;
        rdfs:label          "Regulation of PAK-2p34 activity by PS-GAP/RHG10" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: Chang, E, 2008-05-21 00:05:41" , "Edited: Matthews, L, 2008-02-03 20:50:13" , "Edited: Matthews, L, 2008-06-12 00:23:53" , "Authored: Jakobi, R, 2008-02-05 11:04:14" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-211728" ;
