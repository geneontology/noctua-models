:R-HSA-1433617  a           owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "Mature NODAL can form heterodimers with LEFTY1, LEFTY2, or CERBERUS. The heterodimers do not activate the NODAL receptor. LEFTY1 and LEFTY2 also bind CRIPTO and CRYPTIC coreceptors and prevent them from interacting with other components of the NODAL receptor. By these mechanisms LEFTY1, LEFTY2, and CERBERUS negatively regulate NODAL signaling (reviewed in Shen 2007, Schier 2009)." ;
        rdfs:label          "Regulation of signaling by NODAL" ;
        dc:contributor      "Edited: May, B, 2011-07-11" , "Authored: May, B, 2011-07-11" , "GOC:reactome_curators" , "Reviewed: May, B, 2011-08-18" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-1433617" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1181150/R-HSA-1181150> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

