:R-HSA-5661270  a           obo:GO_0042840 , owl:NamedIndividual ;
        rdfs:comment        "Automated change 2026-05-28: GO:0019640 replaced by GO:0042840" , "The conversion of D-glucuronate to D-xylulose-5-phosphate, an intermediate in the pentose phosphate pathway, proceeds via L-gulonate, 3-dehydro-L-gulonate, L-xylulose, xylitol, and D-xylulose (Wamelink et al. 2008). D-glucuronate can be generated via the degradation of glucuronidated proteins. This pathway would have the effect of returning it to the pentose phosphate pathway or glycolysis." ;
        rdfs:label          "Formation of xylulose-5-phosphate" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: D'Eustachio, Peter, 2015-08-13" , "Reviewed: Jassal, Bijay, 2015-08-13" , "Edited: D'Eustachio, Peter, 2015-08-13" ;
        dc:date             "2026-05-28" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-5661270" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-71387/R-HSA-71387> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

