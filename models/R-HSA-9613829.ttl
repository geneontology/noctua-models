:R-HSA-9613829  a           owl:NamedIndividual , obo:GO_0061684 ;
        rdfs:comment        "In contrary to the vesicle-mediated macroautophagy, the chaperone mediated mechanism of autophagy selectively targets individual proteins to the lysosome for degradation. Chaperones bind intracellular proteins based on recognition motifs and transports them from the cytosol to the lysosomal membrane. Subsequently, the protein is translocated into the lumen for digestion (Cuervo A M et al. 2014, Kaushik S et al. 2018)." ;
        rdfs:label          "Chaperone Mediated Autophagy" ;
        dc:contributor      "Edited: Varusai, Thawfeek, 2019-11-08" , "Reviewed: Metzakopian, Emmanouil, 2019-02-22" , "Authored: Varusai, Thawfeek, 2019-02-21" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9613829" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-9612973/R-HSA-9612973> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

