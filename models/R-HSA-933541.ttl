gomodel:ev_w_id_R-HSA-933536_RO_0002233_R-HSA-450306_R-HSA-933536_Reactome_R-HSA-933541
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
        dc:date         "2023-06-21" ;
        dc:source       "Reactome:R-HSA-933541" ;
        pav:providedBy  "https://reactome.org" .

:R-HSA-933541  a            owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "TRAF6 is crucial for both RIG-I- and MDA5-mediated antiviral responses. The absence of TRAF6 resulted in enhanced viral replication and a significant reduction in the production of type I IFNs and IL6 after infection with RNA virus. Activation of NF-kB and IRF7, but not that of IRF3, was significantly impaired during RIG-like helicases (RLHs) signaling in the absence of TRAF6. TRAF6-induced activation of IRF is likely to be specific for IRF7, while TRAF3 is thought to activate both IRF3 and IRF7. These results strongly suggest that the TRAF6- and TRAF3-dependent pathways are likely to bifurcate at IPS-1, but to converge later at IRF7 in order to co-operatively induce sufficient production of type I IFNs during RLH signaling." ;
        rdfs:label          "TRAF6 mediated IRF7 activation" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: Garapati, P V, 2010-08-02" , "Reviewed: Kawai, T, Akira, S, 2010-10-30" , "Edited: Garapati, P V, 2010-08-02" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-933541" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-168928/R-HSA-168928> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

