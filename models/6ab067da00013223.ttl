[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://model.geneontology.org/6ab067da00013223/6ab067da00013231> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/BFO_0000066> ;
   owl:annotatedTarget <http://model.geneontology.org/6ab067da00013223/6ab067da00013233> ;
   <http://geneontology.org/lego/evidence> <http://model.geneontology.org/6ab067da00013223/6ab067da00013309> ;
