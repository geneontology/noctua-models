gomodel:600ced8500000599
        a                owl:Ontology ;
        rdfs:comment     "General: Published in https://pubmed.ncbi.nlm.nih.gov/34710644, Fig 7. This model represents positive transcription regulation when transcriptional coregulation activity is involved. Note that the GO-CAM guidelines have changed since publication of the paper, and 'has part' DNA binding is not captured in the new guidelines; it is considered to be an implicit part of GO:0001228, and does not need to be captured as a separate MF." ;
        lego:modelstate  "template" ;
        dc:contributor   "https://orcid.org/0000-0002-7558-2880" , "https://orcid.org/0000-0003-1813-6857" ;
        dc:date          "2026-10-30" ;
        dc:title         "Transcription regulation of a promoter - Model 3 (template) GREEKC" ;
        pav:providedBy   "http://greekc.org" , "http://geneontology.org" ;
        owl:versionIRI   gomodel:600ced8500000599 .

