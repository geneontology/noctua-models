        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-9707594" ;
        skos:exactMatch     <http://www.reactome.org/biopax/84/48887#BiochemicalReaction13951> ;
