gomodel:R-HSA-9707594
        a                   owl:NamedIndividual , <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#molecular_event> ;
        rdfs:label          "Hemes bind LY96" ;
        obo:BFO_0000050     :R-HSA-9707616 ;
        obo:BFO_0000066     gomodel:reaction_R-HSA-9707594_location_lociGO_0005576 ;
        obo:RO_0002233      gomodel:R-HSA-9707658_R-HSA-9707594 , gomodel:R-ALL-9707310_R-HSA-9707594 ;
        obo:RO_0002234      gomodel:R-HSA-9707530_R-HSA-9707594 ;
        obo:RO_0002413      gomodel:R-HSA-9707659 ;
        dc:contributor      "GOC:reactome_curators" ;
