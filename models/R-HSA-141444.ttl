:R-HSA-141444  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "The signal from unattached kinetochores is amplified through a Mad2 inhibitory signal that is propagated by the binding of Mad1 to the kinetochore, the association of Mad2 with Mad1, the conversion of Mad2 conformation to an inhibitory form through its association with Mad1 and finally the release of the inhibitory form of Mad2 from the kinetochore." ;
        rdfs:label          "Amplification of signal from unattached kinetochores via a MAD2 inhibitory signal" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: Yen, T, 2004-05-05 00:00:00" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-141444" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-141424/R-HSA-141424> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

