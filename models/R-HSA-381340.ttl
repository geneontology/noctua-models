        obo:RO_0002413      gomodel:R-HSA-977392_binding_R-HSA-381280_R-HSA-381283_controller , gomodel:R-HSA-977392_binding_R-HSA-381280_R-HSA-977271_controller , gomodel:R-HSA-977392_binding_R-HSA-381280_R-HSA-381377_controller ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-977392" ;
