gomodel:109806_R-HSA-64847
        a               owl:NamedIndividual , <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-64847> ;
        rdfs:comment    "Active unit in R-HSA-109798" ;
        dc:contributor  "GOC:reactome_curators" ;
        dc:date         "2023-06-21" ;
        pav:providedBy  "https://reactome.org" .

:R-HSA-171007  a            owl:NamedIndividual , obo:GO_0008150 ;
        rdfs:comment        "NGF induces sustained activation of p38, a member of the MAPK family (Morooka T, Nishida E, 1998). Both p38 and the ERKs appear to be involved in neurite outgrowth and differentiation caused by NGF in PC12 cells. As a matter of fact, PC12 cell differentiation appears to involve activation of both ERK/MAPK and p38. Both ERK/MAPK and p38 pathways contribute to the phosphorylation of the transcription factor CREB and the activation of immediate-early genes (Xing J, 1998). p38 activation by NGF may occur by at least two mechanisms, involving SRC or MEK kinases." ;
        rdfs:label          "p38MAPK events" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: Greene, LA, 2007-11-08 15:39:37" , "Edited: Jassal, Bijay, 2006-10-10" , "Authored: Nasi, Sergio, Annibali, D, 2006-10-10" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-171007" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-167044/R-HSA-167044> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

