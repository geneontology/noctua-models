        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-196299" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-195253/R-HSA-195253> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

