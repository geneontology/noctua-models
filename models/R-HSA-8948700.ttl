:R-HSA-8948700  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Coding and non-coding RNAs can prevent microRNAs from binding to PTEN mRNA. These RNAs are termed competing endogenous RNAs or ceRNAs. Transcripts of the pseudogene PTENP1 and mRNAs transcribed from SERINC1, VAPA and CNOT6L genes exhibit this activity (Poliseno et al. 2010, Tay et al. 2011, Tay et al. 2014). SERINC1 mRNA will be annotated in this context when additional experimental details become available." ;
        rdfs:label          "Competing endogenous RNAs (ceRNAs) regulate PTEN translation" ;
        dc:contributor      "Authored: Salmena, Leonardo, 2016-08-11" , "Authored: Carracedo, Arkaitz, 2016-08-11" , "Edited: Orlic-Milacic, Marija, 2017-05-09" , "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2016-11-03" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8948700" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-8943723/R-HSA-8943723> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

