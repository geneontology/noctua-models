oboInOwl:hasDbXref  a  owl:AnnotationProperty .

:R-HSA-380095  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Tachykinin peptides are one of the largest family of neuropeptides, so named due to their ability to rapidly induce contraction of gut tissue. Tachykinins excite neurons, elicit behavioural responses, are potent vasodilators and contract many smooth muscles. The tachykinin family is characterized by a common C-terminal sequence, Phe-X-Gly-Leu-Met-NH2 (where X can be either an aromatic or an aliphatic amino acid) and are ten to twelve residues long.<br><br>These peptides elicit their effects via the tachykinin receptors, of which there are three types in humans (NK1,2 and 3). There are two human tachykinin peptide genes in humans, TAC1 and TAC3. TAC1 encodes substance P and substance K while TAC3 encodes neurokinin B.<br><br>Antagonists of these receptors are promising candidates for classes of antidepressants, anxiolytics and antipsychotics." ;
        rdfs:label          "Tachykinin receptors bind tachykinins" ;
        dc:contributor      "Authored: Jassal, B, 2008-11-24 14:25:55" , "Reviewed: D'Eustachio, P, 2009-03-02 09:24:35" , "GOC:reactome_curators" , "Edited: Jassal, B, 2008-11-24 14:25:55" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-380095" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-375276/R-HSA-375276> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

