:R-HSA-1482798  a           obo:GO_0035965 , owl:NamedIndividual ;
        rdfs:comment        "Acyl chain remodeling of cardiolipin (CL) occurs in the inner mitochondria membranes (IM) via hydrolysis by phopholipases and subsequent reacylation by acyltransferases. At the endoplasmic reticulum (ER) membrane the situation is more complicated with monolysocardiolipin (MLCL) involved in hydrolysis and subsequent reacylation back to CL (Zachman et al. 2010, Malhotra et al. 2009, Xu et al. 2003, Taylor & Hatch 2009, Cao et al. 2004, Zhao et al. 2009, Buckland et al. 1998)." ;
        rdfs:label          "Acyl chain remodeling of CL" ;
        dc:contributor      "Authored: Williams, MG, 2011-09-14" , "GOC:reactome_curators" , "Edited: Williams, MG, 2011-08-12" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-1482798" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1483206/R-HSA-1483206> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

