skos:note  a    owl:AnnotationProperty .

:R-HSA-391251  a            owl:NamedIndividual , obo:GO_0051084 ;
        rdfs:comment        "Due to the crowded envirnoment within the cell, many proteins must interact with molecular chaperones to attain their native conformation (reviewed in Young et al., 2004). Chaperones recognize and associate with proteins in their non-native state and facilitate their folding by stabilizing the conformation of productive folding intermediates. Chaperones that take part broadly in de novo protein folding, such as the Hsp70s and the chaperonins, facilitate the folding process through cycles of substrate binding and release regulated by their ATPase activity (see Young et al., 2004; Spiess et al., 2004; Bigotti and Clarke, 2008)." ;
        rdfs:label          "Protein folding" ;
        dc:contributor      "Reviewed: Cowan, NJ, 2009-01-21 16:47:24" , "GOC:reactome_curators" , "Edited: Matthews, L, 2009-02-21 04:38:35" , "Authored: Matthews, L, 2008-12-01 04:46:41" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-391251" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-392499/R-HSA-392499> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

