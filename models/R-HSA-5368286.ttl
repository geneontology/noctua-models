        a                   obo:GO_0003924 , owl:NamedIndividual ;
        rdfs:label          "39S subunit binds 28S subunit:mRNA:fMet-tRNA" ;
        obo:BFO_0000050     :R-HSA-5368286 ;
        obo:BFO_0000066     gomodel:reaction_R-HSA-5389839_location_lociGO_0005743 ;
        obo:RO_0002233      gomodel:R-HSA-5368280_R-HSA-5389839 , gomodel:R-HSA-5368233_R-HSA-5389839 ;
