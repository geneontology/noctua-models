   owl:annotatedSource <http://model.geneontology.org/584b49fa00000436/5fce9b7300000080> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/RO_0002233> ;
   owl:annotatedTarget <http://model.geneontology.org/584b49fa00000436/5fce9b7300000078> ;
   <http://geneontology.org/lego/evidence> <http://model.geneontology.org/584b49fa00000436/5fce9b7300000093> ;
   <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0002-1706-4196" ;
   <http://purl.org/dc/elements/1.1/date> "2020-12-14" ;
   <http://purl.org/pav/providedBy> "http://www.wormbase.org" ;
   rdfs:comment """Supporting evidence statement (PMID:16208361): The wild-type CED-3 zymogen, generated by in vitro translation,
was slowly autoprocessed as previously reported9,29 (Fig. 5b, lanes
1–3). The autoprocessing requires the catalytic residue Cys 358, as the
mutation C358S abolished CED-3 autoactivation (Fig. 5b, lanes 4
and 5). This result indicates that the processing of the CED-3
zymogen is not due to other contaminating protease(s)."""
 ] .

