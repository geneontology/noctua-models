gomodel:ev_w_id_R-HSA-5082369_RO_0002234_R-HSA-5082365_R-HSA-5082369_Reactome_R-HSA-3371568
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
