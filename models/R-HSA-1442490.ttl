gomodel:ev_w_id_R-HSA-1564117_RO_0002233_R-HSA-2143434_R-HSA-1564117_Reactome_R-HSA-1564117
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
