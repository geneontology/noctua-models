        a       owl:Class .

:R-HSA-8849474  a           owl:NamedIndividual , obo:GO_0042531 ;
        rdfs:comment        "PTK6-mediated phosphorylation activates STAT3 transcription factor via STAP2 adapter protein. STAT3 transcriptional target SOCS3 is a negative regulator of PTK6 and inhibits PTK6-mediated phosphorylation of STAT3, thus creating a negative feedback loop (Liu et al. 2006, Ikeda et al. 2009, Ikeda et al. 2010). PTK6 may also activate STAT5-mediated transcription (Ikeda et al. 2011)." ;
        rdfs:label          "PTK6 Activates STAT3" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2016-01-04" , "Edited: Orlic-Milacic, Marija, 2016-01-04" , "Reviewed: Pires, Isabel M, 2016-02-07" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8849474" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-8848021/R-HSA-8848021> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

