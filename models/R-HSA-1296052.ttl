:R-HSA-1296052  a           owl:NamedIndividual , obo:GO_1901381 ;
        rdfs:comment        "Ca2+ activated potassium channels are expressed in neuronal and non-neuronal tissue such as smooth muscle, epithelial cell and sensory cells. Ca2+ activated potassium channels are activated when the Ca2+ ion concentration increased, The efflux of K+ via these channels leads to repolarization/hyperpolarization of the membrane potential which limits the Ca2+ influx though voltage activated Ca2+ channels (VGCC) thereby regulating the influx of Ca2+ flow via VGCC." ;
        rdfs:label          "Ca activated K+ channels" ;
        dc:contributor      "Authored: Mahajan, SS, 2011-05-18" , "GOC:reactome_curators" , "Reviewed: Jassal, Bijay, 2010-09-23" , "Edited: Mahajan, SS, 2011-05-23" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-1296052" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1296071/R-HSA-1296071> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

