dc:title  a     owl:AnnotationProperty .

:R-HSA-392023  a            owl:NamedIndividual , obo:GO_0030168 ;
        rdfs:comment        "Adrenaline (epinephrine) signalling via the alpha-2 adrenergic receptor has many effects including inhibition of insulin release in pancreas, iinduction of glucagon release from pancreas, contraction of sphincters of the gastrointestinal tract, negative feedback processes in neuronal synapses and stimulation of platelet aggregation. This receptor preferentially couples to members of the Gi class of heterotrimeric G-proteins, leading to inhibition af adenylate cyclase and thereby decreased cAMP levels." ;
        rdfs:label          "Adrenaline signalling through Alpha-2 adrenergic receptor" ;
        dc:contributor      "Reviewed: Akkerman, JW, 2009-09-04" , "GOC:reactome_curators" , "Edited: Jupe, S, 2009-09-10" , "Authored: Jupe, S, 2009-02-26 15:48:59" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-392023" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-76009/R-HSA-76009> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

