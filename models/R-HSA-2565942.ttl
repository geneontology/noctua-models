gomodel:R-HSA-2562537_R-HSA-2562526
        a                   <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-2562537> , owl:NamedIndividual ;
        rdfs:comment        "located_in Golgi membrane" ;
        rdfs:label          "OPTN:RAB8A:GTP" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-2562537" ;
