<http://model.geneontology.org/6ab067da00008005> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00008005> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-19"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Autophagosome assembly via ER-anchored ATG2B lipid transfer (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                   "https://www.uniprot.org" ;
                                                  rdfs:comment "Curated with GO AI HUB. ATG2B transfers PE from the ER to the phagophore (PMID:31721365, PMID:42842923). MOSPD1 and MOSPD3 each recruit ATG2B to the ER via its FFNT motif, but autophagic flux requires both (single KOs impaired; DKO rescued only by co-expression; PMID:42842923); they self-associate and hetero-associate via their transmembrane regions (PMID:33296653), so the ER adaptor is captured as a MOSPD1-MOSPD3 complex. Placeholder: GO:0098796 membrane protein complex, pending a GO term request for 'MOSPD1-MOSPD3 complex'. WDR45/WIPI4 stimulates ATG2B lipid transfer (PMID:31721365); TRAPPC11 is required for recruitment of ATG2B-WIPI4 to isolation membranes (PMID:30843302)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

