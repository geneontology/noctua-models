gomodel:6ab067da00008005
        a                      owl:Ontology ;
        rdfs:comment           "Curated with GO AI HUB. ATG2B transfers PE from the ER to the phagophore (PMID:31721365, PMID:42842923). MOSPD1 and MOSPD3 each recruit ATG2B to the ER via its FFNT motif, but autophagic flux requires both (single KOs impaired; DKO rescued only by co-expression; PMID:42842923); they self-associate and hetero-associate via their transmembrane regions (PMID:33296653), so the ER adaptor is captured as a MOSPD1-MOSPD3 complex. Placeholder: GO:0098796 membrane protein complex, pending a GO term request for 'MOSPD1-MOSPD3 complex'. WDR45/WIPI4 stimulates ATG2B lipid transfer (PMID:31721365); TRAPPC11 is required for recruitment of ATG2B-WIPI4 to isolation membranes (PMID:30843302)." ;
        lego:conforms_to_gpad  false ;
        lego:modelstate        "production" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-10-23" ;
        dc:title               "Autophagosome assembly via ER-anchored ATG2B lipid transfer (Human)" ;
        pav:providedBy         "https://www.uniprot.org" , "http://geneontology.org" ;
        owl:versionIRI         gomodel:6ab067da00008005 ;
        biolink:in_taxon       obo:NCBITaxon_9606 .

