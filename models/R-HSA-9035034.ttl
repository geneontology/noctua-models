:R-HSA-9035034  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "This pathway catalogues RHOF (RIF) GTPase activator proteins (GAPs) and RHOF effectors. RHOF GTPase is thought to exist in the active GTP-bound state in the absence of any GEF activity (Tian et al. 2017). No GDP dissociation inhibitors (GDIs) have been shown to interact with RHOF. RHOF is only found in vertebrates (Gad and Aspenstrom 2010; Fan and Mellor 2012). RHOF regulates cytoskeletal dynamics (Gad and Aspenstrom 2010; Aspenstrom et al. 2014) and promotes the formation of filopodia and stress fibers (Fan and Mellor 2012). RHOF may be involved in actin remodelling in lymphocyte microvilli (Fan and Mellor 2012). In neurons, RHOF contributes to the formation of dendritic spines (Fan and Mellor 2012)." ;
        rdfs:label          "RHOF GTPase cycle" ;
        dc:contributor      "Reviewed: Bisbal, Mariano, 2021-02-20" , "Reviewed: Fort, Philippe, 2021-02-05" , "Edited: Orlic-Milacic, Marija, 2021-03-26" , "Edited: Orlic-Milacic, Marija, 2021-02-25" , "Authored: Orlic-Milacic, Marija, 2020-07-14" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9035034" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-9012999/R-HSA-9012999> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

