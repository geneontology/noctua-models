        rdfs:label          "IL10 dimer:2xIL10RA:p-Y-JAK1:2xIL10RB:p-Y-TYK2" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-6784339" ;
