obo:ECO_0000313  a  owl:Class .

:R-HSA-391903  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Eicosanoids, derived from polyunsaturated 20-carbon fatty acids, are paracrine and autocrine regulators of inflammation, smooth muscle contraction, and blood coagulation. The actions of eicosanoids are mediated by eicosanoid receptors, most of which are GPCRs. There are four types of eicosanoid GPCRs in humans; leukotriene, lipoxin (Brink C et al, 2003), prostanoid (Coleman RA et al, 1994) and oxoeicosanoid (Brink C et al, 2004) receptors." ;
        rdfs:label          "Eicosanoid ligand-binding receptors" ;
        dc:contributor      "Reviewed: D'Eustachio, P, 2009-05-29 07:44:22" , "GOC:reactome_curators" , "Authored: Jassal, Bijay, 2009-02-25" , "Edited: Jassal, Bijay, 2009-02-25" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-391903" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-373076/R-HSA-373076> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

