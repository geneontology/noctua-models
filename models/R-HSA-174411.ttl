<http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-9668907>
        a       owl:Class .

:R-HSA-174411  a            owl:NamedIndividual , obo:GO_0032201 ;
        rdfs:comment        "After the primers are synthesized on the G-Rich strand, Replication Factor C binds to the 3'-end of the initiator DNA to trigger polymerase switching. The non-processive nature of pol alpha catalytic activity and the tight binding of Replication Factor C to the primer-template junction presumably lead to the turnover of the pol alpha:primase complex. After the Pol alpha-primase primase complex is displaced from the primer, the proliferating cell nuclear antigen (PCNA) binds to form a \"sliding clamp\" structure. Replication Factor C then dissociates, and DNA polymerase delta binds and catalyzes the processive synthesis of DNA." ;
        rdfs:label          "Polymerase switching on the C-strand of the telomere" ;
        dc:contributor      "Reviewed: Hayashi, Makoto T, 2020-04-29" , "Edited: Orlic-Milacic, Marija, 2020-05-04" , "GOC:reactome_curators" , "Authored: Blackburn, EH, Seidel, J, 2006-03-09 19:41:08" , "Reviewed: Price, C, 2006-07-13 18:33:38" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-174411" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-174417/R-HSA-174417> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

