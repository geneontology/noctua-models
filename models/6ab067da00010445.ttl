<http://model.geneontology.org/6ab067da00010445> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00010445> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-23"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Negative regulation of Ros1 signaling by Ptpn6 in epididymis (Mouse)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Curated with GO AI HUB. Mouse corrected copy of gomodel:65d7e4ac00000470 (PTPN6 negatively regulates ROS1), with direct evidence from Keilhack et al. 2001 (PMID:11266449): Ros hyperphosphorylation in me(v) Ptpn6-mutant epididymis (Fig 3), SHP-1 N-SH2 binding to Ros pY2267 and Ros dephosphorylation (Figs 4-5), SHP-1 suppression of TrkA-Ros proliferation in NIH3T3 (Fig 6)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_10090> .

