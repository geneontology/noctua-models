gomodel:6ab067da00010445
        a                      owl:Ontology ;
        rdfs:comment           "Curated with GO AI HUB. Mouse corrected copy of gomodel:65d7e4ac00000470 (PTPN6 negatively regulates ROS1), with direct evidence from Keilhack et al. 2001 (PMID:11266449): Ros hyperphosphorylation in me(v) Ptpn6-mutant epididymis (Fig 3), SHP-1 N-SH2 binding to Ros pY2267 and Ros dephosphorylation (Figs 4-5), SHP-1 suppression of TrkA-Ros proliferation in NIH3T3 (Fig 6)." ;
        lego:conforms_to_gpad  false ;
        lego:modelstate        "development" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-10-23" ;
        dc:title               "Negative regulation of Ros1 signaling by Ptpn6 in epididymis (Mouse)" ;
        pav:providedBy         "http://geneontology.org" ;
        owl:versionIRI         gomodel:6ab067da00010445 ;
        biolink:in_taxon       obo:NCBITaxon_10090 .

