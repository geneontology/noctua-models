skos:narrower  a  owl:AnnotationProperty .

:R-HSA-8866911  a           obo:GO_0006357 , owl:NamedIndividual ;
        rdfs:comment        "TFAP2A and TFAP2C play opposing roles in transcriptional regulation of the CDKN1A (p21) gene locus. While TFAP2A stimulates transcription of the CDKN1A cyclin-dependent kinase inhibitor (Zeng et al. 1997, Williams et al. 2009, Scibetta et al. 2010), TFAP2C, in cooperation with MYC and histone demethylase KDM5B, represses CDKN1A transcription (Williams et al. 2009, Scibetta et al. 2010, Wong et al. 2012)." ;
        rdfs:label          "TFAP2 (AP-2) family regulates transcription of cell cycle factors" ;
        dc:contributor      "Reviewed: Zarelli, Valeria E, 2016-05-04" , "Reviewed: Bogachek, Maria V, 2016-05-17" , "Reviewed: Weigel, Ronald J, 2016-05-17" , "Edited: Orlic-Milacic, Marija, 2016-03-14" , "Authored: Orlic-Milacic, Marija, 2016-03-14" , "GOC:reactome_curators" , "Reviewed: Dawid, Igor B, 2016-05-04" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8866911" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-8864260/R-HSA-8864260> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

