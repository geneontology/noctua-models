<http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-159767>
        a       owl:Class .

:R-HSA-159782  a            obo:GO_0051604 , owl:NamedIndividual ;
        rdfs:comment        "Furin is an endopeptidase localized to the Golgi membrane that cleaves many proteins on the carboxyterminal side of the sequence motif Arg-[any residue]-(Lys or Arg)-Arg (Jones et al. 1995; Leduc et al. 1992). In the case of gamma-carboxylated proteins, if this cleavage does not occur, the proteins are still secreted but do not function properly (Bristol et al. 1993; Lind et al. 1997; Wasley et al. 1993). The aminoterminal fragments, \"propeptides\", generated in this reaction have no known function; the carboxylated, cleaved proteins are delivered to the cell membrane or secreted from the cell." , "Automated change 2026-01-22: GO:0006465 replaced by GO:0051604" ;
        rdfs:label          "Removal of aminoterminal propeptides from gamma-carboxylated proteins" ;
        dc:contributor      "Authored: D'Eustachio, P, 2005-03-17 16:24:57" , "GOC:reactome_curators" , "Edited: D'Eustachio, P, 0000-00-00 00:00:00" ;
        dc:date             "2026-01-22" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-159782" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-159854/R-HSA-159854> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

