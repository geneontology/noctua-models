:R-HSA-190370  a            obo:GO_0008543 , owl:NamedIndividual ;
        rdfs:comment        "This pathway depicts the binding of an experimentally-verified range of ligands to FGFR1b. While binding affinities may vary considerably within this set, the ligands listed have been established to bring about receptor activation at their reported physiological concentrations." ;
        rdfs:label          "FGFR1b ligand binding and activation" ;
        dc:contributor      "GOC:reactome_curators" , "Authored: de Bono, B, 2007-01-10 10:27:18" , "Reviewed: Mohammadi, M, 2007-02-06 21:44:35" ;
        dc:date             "2026-07-02" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-190370" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-190242/R-HSA-190242> ;
