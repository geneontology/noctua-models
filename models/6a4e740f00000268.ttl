gomodel:6a4e740f00000268 a owl:Ontology ;
    lego:conforms_to_gpad false ;
    lego:modelstate "development" ;
    dc:contributor "https://orcid.org/0000-0002-8534-6582",
        "https://orcid.org/0000-0003-1813-6857"^^xsd:string,
        "https://orcid.org/0009-0003-9059-1333"^^xsd:string ;
    dc:date "2026-07-30"^^xsd:string ;
    dc:title "FOXO-CDKN1B signaling (HUMAN)"^^xsd:string ;
    pav:providedBy "http://geneontology.org"^^xsd:string,
        "http://greekc.org",
        "http://www.pombase.org"^^xsd:string ;
    rdfs:comment "Created with GO AI HUB.",
        "General: Curated by claude4go (v3). Rebuild of v2 (gomodel:6a4e740f00000205) to also give every activity its OWN part_of BP individual and occurs_in CC individual (no shared context instances), extending the distinct-individuals-per-activity-unit rule beyond has_input/enabled_by. Spine: IGF1R>PI3K>AKT (PMID:19951971,TAS) -| FOXO4 (PMID:10217147); FOXO4/FOXO3 activate CDKN1B/p27 -> G1/S arrest (PMID:10783894,PMID:18393360); c-Myc corepressor -| FOXO3 (PMID:18393360). SCP4/CTDSPL2 dephosphorylates/activates FOXO1/FOXO3 (PMID:28851713). FOXO1 -> G6PC1,PCK1 (PMID:28851713); PGC-1a coactivator -> G6PC1 parallel arm (PMID:17024043, argues PGC-1a effect on G6Pase is independent of FOXO1). AS160/TBC1D4 (PMID:11994271) peripheral AKT substrate, per curator request."^^xsd:string,
        "General: Merged PR as a test for the 2026-07-30 Noctua outage."^^xsd:string ;
    biolink:in_taxon obo:NCBITaxon_9606 .

