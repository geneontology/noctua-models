<http://model.geneontology.org/6ab067da00015551> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00015551> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "true"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-7299-6685" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-11-16"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Lactate is imported into the cytosol by Slc16a1 and then converted into pyruvate by Ldha before import into the mitochondria by Mpc1 (Mouse)."^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                   "https://www.uniprot.org" ;
                                                  rdfs:comment "Curated with GO AI HUB. The classic cytosolic route in mouse, modelled generally rather than tissue-restricted: Slc16a1 imports lactate to the cytosol, Ldha oxidises it to pyruvate, and Mpc1 carries that pyruvate into the mitochondrial matrix."^^xsd:string ;
                                                  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://model.geneontology.org/6ab067da00015433> ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_10090> .

