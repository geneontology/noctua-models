gomodel:6ab067da00015551
        a                      owl:Ontology ;
        rdfs:comment           "Curated with GO AI HUB. The classic cytosolic route in mouse, modelled generally rather than tissue-restricted: Slc16a1 imports lactate to the cytosol, Ldha oxidises it to pyruvate, and Mpc1 carries that pyruvate into the mitochondrial matrix." ;
        lego:conforms_to_gpad  true ;
        lego:modelstate        "development" ;
        dc:contributor         "https://orcid.org/0000-0001-7299-6685" ;
        dc:date                "2026-11-16" ;
        dc:title               "Lactate is imported into the cytosol by Slc16a1 and then converted into pyruvate by Ldha before import into the mitochondria by Mpc1 (Mouse)." ;
        pav:providedBy         "https://www.uniprot.org" , "http://geneontology.org" ;
        owl:versionIRI         gomodel:6ab067da00015551 ;
        <http://www.w3.org/ns/prov#wasDerivedFrom>
