<http://model.geneontology.org/6ab067da00006230> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00006230> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-10-08"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "Lipid storage via ATG2A-mediated diacylglycerol transfer to DGAT2 on lipid droplets (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ,
                                                                                   "https://www.uniprot.org" ;
                                                  rdfs:comment "Curated with GO AI HUB. ATG2A transfers diacylglycerol (DAG) from the ER to lipid droplets at ER-lipid droplet contact sites; DAG made by LPIN1 in the ER is converted to triacylglycerol by DGAT2 on the lipid droplet, which requires ATG2A transfer activity for its lipid droplet localization (PMID:41249819)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

