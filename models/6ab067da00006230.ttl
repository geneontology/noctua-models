gomodel:6ab067da00006230
        a                      owl:Ontology ;
        rdfs:comment           "Curated with GO AI HUB. ATG2A transfers diacylglycerol (DAG) from the ER to lipid droplets at ER-lipid droplet contact sites; DAG made by LPIN1 in the ER is converted to triacylglycerol by DGAT2 on the lipid droplet, which requires ATG2A transfer activity for its lipid droplet localization (PMID:41249819)." ;
        lego:conforms_to_gpad  false ;
        lego:modelstate        "development" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-10-08" ;
        dc:title               "Lipid storage via ATG2A-mediated diacylglycerol transfer to DGAT2 on lipid droplets (Human)" ;
        pav:providedBy         "http://geneontology.org" , "https://www.uniprot.org" ;
        owl:versionIRI         gomodel:6ab067da00006230 ;
        biolink:in_taxon       obo:NCBITaxon_9606 .

