:6ac817cf00003214  a        owl:NamedIndividual , obo:ECO_0000305 ;
        rdfs:comment        "Justification for evidence: PMID:31374326 show GNAS presence in pancreatic islet (UBERON:0000006) and correlation between GNAS levels and insulin secretion (GO:0035774). Up to 80% of islet cells are beta-pancreatic cells. I can deduce GNAS presence in beta-pancreatic cells. I am not allowed to use UBERON identifiers in the 'with' field therefore I only used  GO term for positive regulation of insulin secretion." ;
        lego:evidence-with  "GO:0035774" ;
        dc:contributor      "https://orcid.org/0000-0002-5283-6593" ;
        dc:date             "2026-10-19" ;
        dc:source           "GO_REF:0000036" ;
        pav:providedBy      "https://www.uniprot.org" .

