        rdfs:label          "Carboxypeptidase E hydrolyzes Insulin(57-89) to yield C-peptide (Insulin(57-87))" ;
        obo:BFO_0000050     :R-HSA-264876 ;
        obo:BFO_0000066     gomodel:reaction_R-HSA-9023159_location_lociGO_0030667 ;
        obo:RO_0002233      gomodel:CHEBI_15377_R-HSA-9023159 , gomodel:R-HSA-9023172_R-HSA-9023159 ;
        obo:RO_0002234      gomodel:CHEBI_32682_R-HSA-9023159 , gomodel:R-HSA-265011_R-HSA-9023159 , gomodel:CHEBI_32551_R-HSA-9023159 ;
