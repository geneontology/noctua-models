:R-HSA-2142712  a           obo:GO_0019372 , owl:NamedIndividual ;
        rdfs:comment        "The 12-eicosatetraenoic acids: 12-hydroperoxy-eicosatetraenoic acid (12-HpETE), 12-hydroxyeicosatetraenoic acid (12-HETE) and 12-oxo-eicosatetraenoic acid (12-oxoETE) are formed after the initial step of arachidonic acid oxidation by the arachidonate 12 and 15 lipoxygenases (ALOX12, ALOX12B and ALOX15 respectively). This part of the pathway is bifurcated at the level of 12S-hydroperoxy-eicosatetraenoic acid (12S-HpETE), which can either be reduced to 12S-hydro-eicosatetraenoic acid (12S-HETE) or converted to hepoxilins (Buczynski et al. 2009, Vance & Vance 2008)." ;
        rdfs:label          "Synthesis of 12-eicosatetraenoic acid derivatives" ;
        dc:contributor      "Reviewed: Rush, MG, 2012-11-10" , "GOC:reactome_curators" , "Authored: Williams, MG, 2012-02-24" , "Edited: Williams, MG, 2012-02-24" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-2142712" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-2142753/R-HSA-2142753> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

