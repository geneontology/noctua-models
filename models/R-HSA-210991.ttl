gomodel:ev_w_id_R-HSA-375135_RO_0002233_R-HSA-197673_R-HSA-375135_Reactome_R-HSA-210991
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
        dc:date         "2023-06-21" ;
        dc:source       "Reactome:R-HSA-210991" ;
        pav:providedBy  "https://reactome.org" .

:R-HSA-210991  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Basigin is a widely expressed transmembrane glycoprotein that belongs to the Ig superfamily and is highly enriched on the surface of epithelial cells. Basigin is involved in intercellular interactions involved in various immunologic phenomena, differentiation, and development, but a major function of basigin is stimulation of synthesis of several matrix metalloproteinases. Basigin also induces angiogenesis via stimulation of VEGF production.<br>Basigin has an extracellular region with two Ig-like domains of which the N-term Ig-like domain is involved in interactions. It undergoes interactions between basigin molecules on opposing cells or on neighbouring cells. It also interacts with a variety of other proteins like caveolin-1, cyclophilins, integrins and annexin II that play important roles in cell proliferation, energy metabolism, migration, adhesion and motion, especially in cancer metastasis." ;
        rdfs:label          "Basigin interactions" ;
        dc:contributor      "Reviewed: Trowsdale, J, 2008-02-26 12:02:59" , "GOC:reactome_curators" , "Authored: de Bono, B, Garapati, P V, 2008-02-26 12:30:30" , "Edited: Garapati, P V, 2009-03-16 17:55:42" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-210991" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-202733/R-HSA-202733> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

