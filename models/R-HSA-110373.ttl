<http://model.geneontology.org/ev_w_id_R-HSA-5649856_BFO_0000050_R-HSA-110373/R-HSA-110373_Reactome_R-HSA-110373>
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
