<http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-5251515>
        a       owl:Class .

:R-HSA-8931987  a           owl:NamedIndividual , obo:GO_0033146 ;
        rdfs:comment        "The RUNX1:CBFB complex can associate with the activated estrogen receptor alpha (ESR1) through direct interaction between RUNX1 and ESR1. The RUNX1:CBFB complex is thus involved in transcriptional regulation of estrogen responsive genes, including GPAM, KCTD6 and AXIN1 (Stender et al. 2010). High GPAM expression correlates with better overall survival in breast cancer (Brockmoller et al. 2012)." ;
        rdfs:label          "RUNX1 regulates estrogen receptor mediated transcription" ;
        dc:contributor      "Authored: Orlic-Milacic, Marija, 2016-09-14" , "Reviewed: Chuang, Linda Shyue Huey, 2016-12-20" , "GOC:reactome_curators" , "Edited: Orlic-Milacic, Marija, 2017-05-09" , "Reviewed: Ito, Yoshiaki, 2016-12-20" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8931987" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-8878171/R-HSA-8878171> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

