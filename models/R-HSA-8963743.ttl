:R-HSA-8963743  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Fats, carbohydrates, and proteins are broken down to small molecules - fatty acids, cholesterol, and glycerol, monosaccharides, and amino acids - within the lumen of the gastrointestinal tract and absorbed into the body principally through enterocytes in the small intestine. Some of the hydrolases that catalyze these reactions are secreted into the gastrointestinal tract; others are associated with the luminal surfaces of enterocytes. Movement of the final products of digestion out of the intestinal lumen is mediated by arrays of transporters associated with the lumenal and basolateral surfaces of enterocytes (Yamada 2015)." ;
        rdfs:label          "Digestion and absorption" ;
        dc:contributor      "Authored: Jassal, Bijay, 2016-08-15" , "Edited: D'Eustachio, Peter, 2017-02-10" , "GOC:reactome_curators" , "Reviewed: D'Eustachio, Peter, 2017-02-10" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-8963743" ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

