gomodel:ev_w_id_R-HSA-8938887_RO_0002233_R-HSA-1031706_R-HSA-8938887_Reactome_R-HSA-8934593
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
