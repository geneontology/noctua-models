obo:GO_0000084  a  owl:Class .

:R-HSA-69242  a             obo:GO_0000084 , owl:NamedIndividual ;
        rdfs:comment        "DNA synthesis occurs in the S phase, or the synthesis phase, of the cell cycle. The cell duplicates its hereditary material, and two copies of the chromosome are formed. As DNA replication continues, the E type cyclins shared by the G1 and S phases, are destroyed and the levels of the mitotic cyclins rise." ;
        rdfs:label          "S Phase" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: Manfredi, James J" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
