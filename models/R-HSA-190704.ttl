gomodel:R-HSA-190656_R-HSA-190693
        a                   owl:NamedIndividual , <http://purl.obolibrary.org/obo/go/extensions/reacto.owl#REACTO_R-HSA-190656> ;
        rdfs:comment        "located_in endoplasmic reticulum membrane" ;
        rdfs:label          "GJB1" ;
        dc:contributor      "GOC:reactome_curators" ;
