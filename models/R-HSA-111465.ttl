:R-HSA-111465  a            obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Apoptotic cell death is achieved by the caspase-mediated cleavage of various vital proteins. Among caspase targets are proteins such as E-cadherin, Beta-catenin, alpha fodrin, GAS2, FADK, alpha adducin, HIP-55, and desmoglein involved in cell adhesion and maintenance of the cytoskeletal architecture. Cleavage of proteins such as APC and CIAP1 can further stimulate apoptosis by produce proapoptotic proteins (reviewed in Fischer et al., 2003. See also Wee et al., 2006 and the CASVM Caspase Substrates Database: http://www.casbase.org/casvm/squery/index.html )." ;
        rdfs:label          "Apoptotic cleavage of cellular proteins" ;
        dc:contributor      "Reviewed: Ranganathan, S, 2007-11-23 00:10:26" , "GOC:reactome_curators" , "Authored: Schulze-Osthoff, K, 2007-09-03 07:52:18" , "Edited: Matthews, L, 2008-02-08 00:41:49" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-111465" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-75153/R-HSA-75153> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

