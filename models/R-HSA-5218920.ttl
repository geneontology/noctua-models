gomodel:ev_w_id_R-HSA-2317314_BFO_0000066_reaction_R-HSA-2317314_location_lociGO_0005886_Reactome_R-HSA-5218920
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
