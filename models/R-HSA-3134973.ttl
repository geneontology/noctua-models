:R-HSA-3134973  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Leucine-rich repeat flightless-interacting protein 1 (LRRFIP1) can bind exogenous double-stranded RNA and double-stranded DNA (Wilson SA et al. 1998; Yang P et al. 2010). LRRFIP1 was shown to mediate Listeria monocytogenes- and vesicular stomatitis virus (VSV)-induced IFN-beta production in mouse primary macrophages by regulating beta-catenin activity. Beta-catenin possibly functions as a transcriptional cofactor of IRF3 to initiate Ifnb1 transcription (Yang P et al. 2010)." ;
        rdfs:label          "LRR FLII-interacting protein 1 (LRRFIP1) activates type I IFN production" ;
        dc:contributor      "Reviewed: Jin, Lei, 2013-05-21" , "GOC:reactome_curators" , "Reviewed: Wu, Jiaxi, 2013-05-21" , "Reviewed: D'Eustachio, P, 2013-02-11" , "Authored: Shamovsky, V, 2013-02-06" , "Edited: Shamovsky, V, 2013-05-17" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-3134973" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1834949/R-HSA-1834949> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

