:R-HSA-9646399  a           owl:NamedIndividual , obo:GO_0035973 ;
        rdfs:comment        "When the capacity of the proteosome to degrade misfolded proteins is limited, the alternate route to eliminate denatured proteins is via forming aggresomes - a process known as aggrephagy. Aggresome formation starts with ubiquitination of misfolded proteins following transport to the microtubule-organizing center (MTOC) with the help of dynein motor proteins. At the MTOC the cargo is encapsulated with intermediate filament proteins to result in the aggresome. Subsequently, this aggresome recruits chaperones that result in its autophagic elimination (Garcia Mata R et al. 2002)." ;
        rdfs:label          "Aggrephagy" ;
        dc:contributor      "Edited: Varusai, Thawfeek, 2019-11-08" , "GOC:reactome_curators" , "Authored: Varusai, Thawfeek, 2019-05-23" , "Reviewed: Metzakopian, Emmanouil, 2019-05-24" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9646399" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-9663891/R-HSA-9663891> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

