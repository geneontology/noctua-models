:R-HSA-9013423  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "This pathway catalogues RAC3 guanine nucleotide exchange factors (GEFs), GTPase activator proteins (GAPs), GDP dissociation inhibitors (GDIs) and RAC3 effectors. RAC3 is highly similar to RAC1 (92% amino acid sequence identity), but it is expressed in fewer tissues than RAC1. RAC3 orthologues only exist in vertebrates (de Curtis 2019). RAC3 is highly expressed in neurons and plays an important role in neuronal and brain development (de Curtis 2014, de Curtis 2019). RAC3 mutations have been reported in patients with intellectual disability and brain malformations (de Curtis 2019). RAC3 is frequently overexpressed in cancer and contributes to proliferation, migration and invasiveness of cancer cells (de Curtis 2019)." ;
        rdfs:label          "RAC3 GTPase cycle" ;
        dc:contributor      "Authored: Rothfels, Karen, 2020-07-14" , "Reviewed: Fort, Philippe, 2021-02-05" , "Edited: Orlic-Milacic, Marija, 2021-02-25" , "GOC:reactome_curators" , "Authored: Orlic-Milacic, Marija, 2020-07-14" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9013423" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-9012999/R-HSA-9012999> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

