dc:title  a     owl:AnnotationProperty .

:R-HSA-429958  a            owl:NamedIndividual , obo:GO_0000288 ;
        rdfs:comment        "Automated change 2024-03-14: GO:0043928 replaced by GO:0000288" , "The degradation of mRNA from 3' to 5' occurs in two steps. First, the exosome exoribonuclease complex binds the 3' end of the oligoadenylated mRNA and hydrolyzes it from 3' to 5', yielding ribonucleotides having 5'-monophosphates, until a capped oligoribonucleotide remains. Second, the scavenging decapping enzyme DCPS hydrolyzes the 7-methylguanosine cap." ;
        rdfs:label          "mRNA decay by 3' to 5' exoribonuclease" ;
        dc:contributor      "GOC:reactome_curators" , "Reviewed: Wilusz, J, 2009-09-17" , "Edited: May, B, 2009-07-22" , "Authored: May, B, 2009-07-22" ;
        dc:date             "2024-03-14" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-429958" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-429914/R-HSA-429914> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

