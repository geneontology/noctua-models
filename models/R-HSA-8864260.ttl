gomodel:ev_w_id_R-HSA-8864278_RO_0002233_R-HSA-8864286_R-HSA-8864278_Reactome_R-HSA-8866907
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
