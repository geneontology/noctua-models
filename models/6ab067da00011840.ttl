gomodel:6ab067da00011840
        a                      owl:Ontology ;
        rdfs:comment           "Replaces stoichiometry test models gomodel:67369e7600000726, 67369e7600000669, 67369e7600000699 ((CHRNA4)3:(CHRNB2)2). Both Na+ and Ca2+ captured on one channel activity. Ca2+ potentiation is specific to this stoichiometry (PMID:38454578)." , "Curated with GO AI HUB. (CHRNA4)3:(CHRNB2)2 nAChR in the cholinergic synapse acetylcholine cycle: VAChT loading, ACHE hydrolysis and calcium potentiation of the channel." ;
        lego:conforms_to_gpad  false ;
        lego:modelstate        "development" ;
        dc:contributor         "https://orcid.org/0000-0001-8769-177X" ;
        dc:date                "2026-11-02" ;
        dc:title               "(CHRNA4)3:(CHRNB2)2 nicotinic acetylcholine receptor in the cholinergic synapse acetylcholine cycle, calcium-potentiated (Human)" ;
        pav:providedBy         "http://geneontology.org" ;
        owl:versionIRI         gomodel:6ab067da00011840 ;
        biolink:in_taxon       obo:NCBITaxon_9606 .

