<http://model.geneontology.org/6ab067da00011840> rdf:type owl:Ontology ;
                                                  owl:versionIRI <http://model.geneontology.org/6ab067da00011840> ;
                                                  <http://geneontology.org/lego/conforms_to_gpad> "false"^^xsd:boolean ;
                                                  <http://geneontology.org/lego/modelstate> "development" ;
                                                  <http://purl.org/dc/elements/1.1/contributor> "https://orcid.org/0000-0001-8769-177X" ;
                                                  <http://purl.org/dc/elements/1.1/date> "2026-11-02"^^xsd:string ;
                                                  <http://purl.org/dc/elements/1.1/title> "(CHRNA4)3:(CHRNB2)2 nicotinic acetylcholine receptor in the cholinergic synapse acetylcholine cycle, calcium-potentiated (Human)"^^xsd:string ;
                                                  <http://purl.org/pav/providedBy> "http://geneontology.org"^^xsd:string ;
                                                  rdfs:comment "Curated with GO AI HUB. (CHRNA4)3:(CHRNB2)2 nAChR in the cholinergic synapse acetylcholine cycle: VAChT loading, ACHE hydrolysis and calcium potentiation of the channel."^^xsd:string ,
                                                               "Replaces stoichiometry test models gomodel:67369e7600000726, 67369e7600000669, 67369e7600000699 ((CHRNA4)3:(CHRNB2)2). Both Na+ and Ca2+ captured on one channel activity. Ca2+ potentiation is specific to this stoichiometry (PMID:38454578)."^^xsd:string ;
                                                  <https://w3id.org/biolink/vocab/in_taxon> <http://purl.obolibrary.org/obo/NCBITaxon_9606> .

