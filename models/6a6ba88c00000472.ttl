gomodel:6a6ba88c00000472 a owl:Ontology ;
    lego:conforms_to_gpad false ;
    lego:modelstate "development" ;
    dc:contributor "https://orcid.org/0000-0003-1522-9900" ;
    dc:date "2026-09-17" ;
    dc:title "mGluR6-G(o)(GNAO1/GNB3/GNG13)-TRPM1 ON bipolar cascade_Visual Perception (Human)" ;
    pav:providedBy "http://geneontology.org",
        "https://www.uniprot.org" ;
    rdfs:comment "2026-09-15: De-entangled activity context so VPE renders all causal edges. Gave Go(GNAO1), Gbeta-gamma-adaptor, TRPM1, and Gbeta-gamma-channel-regulator activities their own plasma membrane + GO:0007216 + GO:0007601 instances (previously all five activities shared one plasma-membrane and one pathway instance, which collapsed them in VPE and hid the pos-reg/neg-reg edges). GRM6 kept on original context. Causal wiring unchanged.",
        "Created with GO AI HUB.",
        "claude4go build 2026-08-17; touch to trigger store/index" ;
    biolink:in_taxon obo:NCBITaxon_9606 .

