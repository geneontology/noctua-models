obo:ECO_0000313  a  owl:Class .

:R-HSA-2473224  a           obo:GO_0008150 , owl:NamedIndividual ;
        rdfs:comment        "Both Follistatin (FST) and Follistatin-like-3 (FSTL3) irreversibly bind Activin dimers and prevent Activin from interacting with its receptor (reviewed in Schneyer et al. 2004, Xia and Schneyer 2009). Though functionally similar in vitro, FST and FSTL3 do not function identically in vivo. Mice lacking FST die shortly after birth due to defects in muscle and bone (Matzuk et al. 1995); mice lacking FSTL3 are viable but have altered glucose metabolism (Mukherjee et al. 2007)." ;
        rdfs:label          "Antagonism of Activin by Follistatin" ;
        dc:contributor      "Reviewed: Chen, Ye-Guang, 2012-11-14" , "Edited: May, B, 2012-09-21" , "GOC:reactome_curators" , "Authored: May, B, 2012-09-21" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-2473224" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-1502540/R-HSA-1502540> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

