:R-HSA-200425  a            owl:NamedIndividual , obo:GO_0006853 ;
        rdfs:comment        "The mitochondrial carnitine system catalyzes the transport of long-chain fatty acids into the mitochondrial matrix where they undergo beta oxidation. This transport system consists of the malonyl-CoA sensitive carnitine palmitoyltransferase I (CPT-I) localized in the mitochondrial outer membrane, the carnitine:acylcarnitine translocase, an integral inner membrane protein, and carnitine palmitoyltransferase II localized on the matrix side of the inner membrane. (Kerner and Hoppel, 2000)." ;
        rdfs:label          "Carnitine metabolism" ;
        dc:contributor      "Reviewed: D'Eustachio, P, 2007-07-31 18:50:15" , "Authored: Gopinathrao, G, 2007-07-29 21:03:03" , "GOC:reactome_curators" , "Edited: Gopinathrao, G, 2007-07-29 21:03:03" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-200425" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-8978868/R-HSA-8978868> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

