[ a                      owl:Axiom ;
  rdfs:comment           "Supporting evidence statement (PMID:16861794): As Fig. 2B shows, YdbR-His6 hydrolyzed ATP in the presence of total B. subtilis RNA as well as in that of transcripts derived from pGEM-3zf (+) plasmid. No difference between the rates of ATPase activity in presence of B. subtilis total RNA and pGEMderived RNA was observed (4 ATP min1 YdbR1). No activity was observed in the absence of RNA (Fig. 2B)." ;
  lego:evidence          :5fce9b7300000044 ;
  dc:contributor         "https://orcid.org/0000-0002-1706-4196" ;
  dc:date                "2020-12-08" ;
  pav:providedBy         "http://www.wormbase.org" ;
  owl:annotatedProperty  obo:BFO_0000051 ;
  owl:annotatedSource    :5fb9cc0600000427 ;
  owl:annotatedTarget    :5fb9cc0600000428
] .

