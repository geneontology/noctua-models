gomodel:R-HSA-9026286
        a                 owl:Ontology ;
        rdfs:comment      "Imported from Reactome: https://reactome.org/content/detail/R-HSA-9026286" , "For logical inference, import the integrated tbox ontology http://purl.obolibrary.org/obo/go/extensions/go-lego-reacto.owl" , "http://www.reactome.org" ;
        lego:modelstate   "development" ;
        dc:contributor    "GOC:reactome_curators" ;
        dc:date           "2023-06-21" ;
        dc:title          "Biosynthesis of DPAn-3-derived protectins and resolvins - imported from: Reactome" ;
        pav:providedBy    "https://reactome.org" ;
        biolink:in_taxon  obo:NCBITaxon_9606 .

:R-HSA-9026286  a           obo:GO_0019372 , owl:NamedIndividual ;
        rdfs:comment        "The polyunsaturated fatty acid (PUFA) Ï‰-3 cis-7,10,13,16,19-docosapentaenoic acid (DPAn-3) is an intermediate in the biosynthesis of docosahexaenoic acid (DHA) from eicosapentaenoic acid (EPA) and is also a precursor for the production of novel bioactive mediators. The proposed biosynthesis of resolvins and protectins derived from DPAn-3 is described here (Dalli et al. 2013, Hansen et al. 2017, Vik et al. 2017). 15-lipoxygenase oxygenates DPAn-3 to its 17(S) hydroperoxy epimer from which resolvins and protectins are formed via a combination of oxygenation, reduction and hydrolysis reactions (Dalli et al. 2013). The products of the Ï‰-3 isomer were characterised based on docosahexaenoic acid (DHA)-derived resolvins and protectins (Serhan et al. 2002) and were demonstrated to have similar potent systemic anti-inflammatory and tissue protective actions as DHA-derived specialised proresolving mediators (SPMs) (Dalli et al. 2013). The same biosynthetic route as DHA-derived SPMs is probably how DPAn-3 products are also formed (Dalli et al. 2013)." ;
        rdfs:label          "Biosynthesis of DPAn-3-derived protectins and resolvins" ;
        dc:contributor      "Authored: Jassal, Bijay, 2017-10-19" , "Reviewed: Hansen, Trond Vidar, 2018-02-21" , "Edited: Jassal, Bijay, 2017-10-19" , "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "R-HSA-9026286" ;
        skos:narrower       <http://model.geneontology.org/R-HSA-9025094/R-HSA-9025094> ;
        skos:note           "org.biopax.paxtools.model.level3.Pathway" .

