<http://model.geneontology.org/ev_w_id_R-HSA-3858495_BFO_0000050_R-HSA-4086400/R-HSA-4086400_Reactome_R-HSA-4086400>
        a               owl:NamedIndividual , obo:ECO_0000313 ;
