gomodel:ev_w_id_R-HSA-5263628_RO_0002233_R-HSA-5263667_R-HSA-5263628_Reactome_R-HSA-445355
        a               owl:NamedIndividual , obo:ECO_0000313 ;
        dc:contributor  "GOC:reactome_curators" ;
