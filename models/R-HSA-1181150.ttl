        rdfs:label          "NODAL Ligand:NODAL Receptor" ;
        dc:contributor      "GOC:reactome_curators" ;
        dc:date             "2023-06-21" ;
        pav:providedBy      "https://reactome.org" ;
        oboInOwl:hasDbXref  "Reactome:R-HSA-1181133" ;
